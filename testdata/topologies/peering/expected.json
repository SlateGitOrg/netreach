    "eni-c": {"tcp": "", "udp": "", "other": ""}
  },
  "internal": [
    {"from": "eni-a", "to": "eni-b", "tcp": "5432", "udp": "", "other": ""},
    {"from": "eni-a", "to": "eni-c", "tcp": "", "udp": "", "other": ""},
    {"from": "eni-b", "to": "eni-c", "tcp": "80", "udp": "", "other": ""},
