    {"kind": "internal", "from": "eni-a", "to": "eni-c", "proto": "tcp", "initiatorPort": 40000, "servicePort": 80, "expect": "block", "step": "route", "component": "rtb-a"},
    {"kind": "internal", "from": "eni-c", "to": "eni-a", "proto": "tcp", "initiatorPort": 40000, "servicePort": 80, "expect": "block", "step": "route", "component": "rtb-c"},
    {"kind": "internal", "from": "eni-b", "to": "eni-c", "proto": "tcp", "initiatorPort": 40000, "servicePort": 80, "expect": "allow"},
    {"kind": "internal", "from": "eni-c", "to": "eni-b", "proto": "tcp", "initiatorPort": 40000, "servicePort": 9000, "expect": "allow"},
    {"kind": "internal", "from": "eni-c", "to": "eni-b", "proto": "tcp", "initiatorPort": 40000, "servicePort": 5432, "expect": "block", "step": "sg-inbound", "component": "sg-b-db"},
    {"kind": "internal", "from": "eni-b", "to": "eni-a", "proto": "tcp", "initiatorPort": 40000, "servicePort": 22, "expect": "block", "step": "sg-inbound", "component": "sg-a-client"},
    {"kind": "internet", "from": "8.8.8.8", "to": "eni-b", "proto": "tcp", "initiatorPort": 40000, "servicePort": 5432, "expect": "block", "step": "internet-gateway", "component": "vpc-b"}
